{
  "name": "@zeldrisho/pi-gate",
  "version": "0.7.2",
  "description": "Pi extension that gates bash commands and protects its configuration from tool edits",
  "keywords": [
    "command-blocking",
    "command-confirmation",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "tool-gate"
  ],
  "homepage": "https://github.com/zeldrisho/pi-packages/tree/main/packages/pi-gate#readme",
  "bugs": {
    "url": "https://github.com/zeldrisho/pi-packages/issues"
  },
  "license": "MIT",
  "author": "zeldrisho",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeldrisho/pi-packages.git",
    "directory": "packages/pi-gate"
  },
  "files": [
    "src",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
